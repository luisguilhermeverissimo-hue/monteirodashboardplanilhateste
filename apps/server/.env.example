# Copie para .env e preencha. NUNCA commitar .env com valores reais.

# Banco de dados (SQLite em dev; ver README para caminho de migração a Postgres)
DATABASE_URL="file:./dev.db"

# Porta do servidor-ponte
PORT=3333

# Origem permitida para CORS (URL da interface em dev)
WEB_ORIGIN="http://localhost:5173"

# JWT para sessão da interface (gerar um valor aleatório forte; nunca reutilizar entre ambientes)
JWT_SECRET="troque-por-um-segredo-forte-gerado-por-ambiente"
JWT_EXPIRES_IN="8h"

# --- API Loy ---
# Em produção estas variáveis devem vir de um secret manager (Vault, AWS/GCP Secrets Manager),
# nunca de um .env em texto puro no servidor. Ver docs/loy-integration-security-review.md §1.1.
LOY_API_BASE_URL="https://api.loylegal.com"
LOY_API_TOKEN="preencher-com-token-de-homologacao"

# Diretório local de armazenamento de documentos baixados (dev apenas;
# em produção usar storage criptografado em repouso - ver revisão de segurança §1.4)
STORAGE_DIR="./storage/documentos"

# Intervalo do motor de coleta (cron). Padrão: a cada 30 minutos.
COLLECTOR_CRON="*/30 * * * *"
